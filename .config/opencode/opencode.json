{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "browsermcp": {
        "type": "local",
        "command": ["npx", "-y", "@browsermcp/mcp@0.1.3"],
        "disabled": true
      }
    }
  },
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },

    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*.env.example", "effect": "ask" },

    { "action": "shell", "resource": "git *", "effect": "allow" },
    { "action": "shell", "resource": "git checkout *", "effect": "deny" },
    { "action": "shell", "resource": "git rebase *", "effect": "deny" },
    { "action": "shell", "resource": "git merge *", "effect": "deny" },
    { "action": "shell", "resource": "git restore *", "effect": "ask" },
    { "action": "shell", "resource": "git switch *", "effect": "ask" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "mv *", "effect": "ask" },

    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/docs", "effect": "allow" },
    { "action": "external_directory", "resource": "~/docs/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/opencode", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/opencode/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.local/share/opencode/*", "effect": "allow" }
  ],
  "experimental": {
    "policies": [
      { "action": "tool.use", "resource": "shell:*gcloud*", "effect": "deny" },
      { "action": "tool.use", "resource": "shell:*gsutil*", "effect": "deny" },
      { "action": "tool.use", "resource": "shell:bq *", "effect": "deny" },
      { "action": "tool.use", "resource": "shell:*/bq *", "effect": "deny" },
      { "action": "tool.use", "resource": "shell:*google-cloud-sdk*", "effect": "deny" },
      { "action": "tool.use", "resource": "read:*.config/gcloud*", "effect": "deny" },
      { "action": "tool.use", "resource": "edit:*.config/gcloud*", "effect": "deny" },
      { "action": "tool.use", "resource": "glob:*gcloud*", "effect": "deny" },
      { "action": "tool.use", "resource": "grep:*gcloud*", "effect": "deny" },
      { "action": "tool.use", "resource": "external_directory:*.config/gcloud*", "effect": "deny" },

      { "action": "tool.use", "resource": "shell:git push *", "effect": "deny" },
      { "action": "tool.use", "resource": "shell:git reset *", "effect": "deny" },
      { "action": "tool.use", "resource": "shell:git clean *", "effect": "deny" },
      { "action": "tool.use", "resource": "shell:git branch -D *", "effect": "deny" },
      { "action": "tool.use", "resource": "shell:git stash drop *", "effect": "deny" },

      { "action": "tool.use", "resource": "shell:rm *", "effect": "deny" },
      { "action": "tool.use", "resource": "shell:rmdir *", "effect": "deny" },
      { "action": "tool.use", "resource": "shell:chmod *", "effect": "deny" },
      { "action": "tool.use", "resource": "shell:chown *", "effect": "deny" },

      { "action": "tool.use", "resource": "read:*.env", "effect": "deny" },
      { "action": "tool.use", "resource": "read:*.env.*", "effect": "deny" },
      { "action": "tool.use", "resource": "read:*.env.example", "effect": "allow" },
      { "action": "tool.use", "resource": "edit:*.env", "effect": "deny" },
      { "action": "tool.use", "resource": "edit:*.env.*", "effect": "deny" },
      { "action": "tool.use", "resource": "edit:*.env.example", "effect": "allow" }
    ]
  }
}
