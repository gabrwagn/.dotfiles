{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-browser"],
  "mcp": {
    "browsermcp": {
      "type": "local",
      "command": ["npx", "-y", "@browsermcp/mcp@0.1.3"],
      "enabled": true
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "**/*.env.example": "allow",
      ".env": "deny",
      ".env.*": "deny",
      ".env.example": "allow"
    },
    "edit": {
      "*": "ask",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "**/*.env.example": "ask",
      ".env": "deny",
      ".env.*": "deny",
      ".env.example": "ask"
    },
    "bash": {
      "git *": "allow",
      "git checkout *": "deny",
      "git rebase *": "deny",
      "git merge *": "deny",
      "git clean *": "deny",
      "git stash drop *": "deny",
      "git branch -D *": "deny",
      "git restore *": "ask",
      "git switch *": "ask",
      "git reset *": "deny",
      "git push *": "ask",
      "git commit *": "ask",
      "rm *": "deny",
      "rmdir *": "deny",
      "mv *": "ask",
      "chmod *": "deny",
      "chown *": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/docs": "allow",
      "~/docs/**": "allow",
      "/tmp/opencode": "allow",
      "/tmp/opencode/**": "allow",
      "~/.local/share/opencode/**": "allow"
    }
  }
}

