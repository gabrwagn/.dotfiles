{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    // NOTE: rule order matters — opencode uses findLast, so later rules
    // override earlier ones. Put broad rules first, narrow exceptions last.
    //
    // "read" patterns are matched against path RELATIVE to the worktree
    // (so reads inside the workspace look like "src/foo.ts", not absolute).
    // External reads are gated separately by "external_directory" using
    // absolute (expanded) paths.

    "read": {
      "*": "allow",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "**/*.env.example": "allow",
      ".env": "deny",
      ".env.*": "deny",
      ".env.example": "allow"
    },
    "edit": {
      "*": "ask",
      "**/*.env": "deny",
      "**/*.env.*": "deny",
      "**/*.env.example": "ask",
      ".env": "deny",
      ".env.*": "deny",
      ".env.example": "ask"
    },
    "bash": {
      "git *": "allow",
      "git checkout *": "deny",
      "git rebase *": "deny",
      "git merge *": "deny",
      "git clean *": "deny",
      "git stash drop *": "deny",
      "git branch -D *": "deny",
      "git restore *": "ask",
      "git switch *": "ask",
      "git reset *": "deny",
      "git push *": "ask",
      "git commit *": "ask",
      "rm *": "deny",
      "rmdir *": "deny",
      "mv *": "ask",
      "chmod *": "deny",
      "chown *": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/docs": "allow",
      "~/docs/**": "allow",
      "/tmp/opencode": "allow",
      "/tmp/opencode/**": "allow",
      "~/.local/share/opencode/**": "allow"
    }
  }
}

