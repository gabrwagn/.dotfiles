# FZF settings
FZF_DEFAULT_COMMAND="fd --type f --hidden -E \"*Test.[ch]pp\" -E \".git\""

# Palette, regenerated by noctalia's fzf template on every colour change.
# The file exports FZF_DEFAULT_OPTS itself, appending to any existing value,
# so it has to be sourced before the options below are set.
[ -r ~/.config/fzf/themes/noctalia.sh ] && source ~/.config/fzf/themes/noctalia.sh
FZF_CTRL_R_OPTS="--reverse --height=100%"
source <(fzf --zsh)
